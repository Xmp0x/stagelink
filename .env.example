# ==============================================================================
# StageLink - Environment Configuration Example
# Copy to .env or .env.local and populate with your local values.
# NEVER commit real secret values or API keys to version control.
# ==============================================================================

# Application
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stagelink?schema=public"

# Authentication & Session Security
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Internship Copilot Configuration
# Feature flag: true to enable AI assistant, false to operate in pure deterministic search mode
AI_ENABLED=true
# Provider options: 'mock' (default, zero cost test double), 'gemini', 'openai', 'anthropic'
AI_PROVIDER=mock
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
AI_MAX_TOKENS_PER_REQUEST=1000

# Private CV & File Storage
# Provider options: 'local' (secure local filesystem storage for dev), 's3' (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH="./storage/private"
# S3 / R2 Configuration (if STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# Admin & Moderation Initial Seed Account
ADMIN_INITIAL_EMAIL="admin@stagelink.ma"
ADMIN_INITIAL_PASSWORD="ChangeMeInProd123!"

# Rate Limiting
RATE_LIMIT_AI_RPM=10
RATE_LIMIT_API_RPM=60
