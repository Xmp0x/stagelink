# ==============================================================================
# StageLink — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Netlify production deployment, set every variable in:
#   Netlify Dashboard → Site → Environment variables
#
# ⚠️  NEVER commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production

# Set this to your live Netlify URL (or custom domain) — required by NextAuth.
# Example: https://stagelink.netlify.app
NEXTAUTH_URL="https://YOUR-SITE.netlify.app"
APP_URL="https://YOUR-SITE.netlify.app"

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# StageLink requires a PostgreSQL 14+ database.
# Free cloud options:
#   • Neon       → https://neon.tech         (serverless Postgres, generous free tier)
#   • Supabase   → https://supabase.com      (Postgres + Storage + Auth)
#   • Railway    → https://railway.app
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stagelink?sslmode=require"

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# MUST be a random 32-byte (256-bit) secret — never reuse dev values in prod.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_RANDOM_32_BYTE_SECRET"

# ------------------------------------------------------------------------------
# AI Internship Copilot
# ------------------------------------------------------------------------------
# Feature toggle
AI_ENABLED=true

# Provider — set to 'mock' for a zero-cost demo, 'gemini' for live AI
# Options: mock | gemini | openai | anthropic
AI_PROVIDER=mock

# Required only when AI_PROVIDER != 'mock'
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
AI_MAX_TOKENS_PER_REQUEST=1000

# ------------------------------------------------------------------------------
# Private CV & File Storage
# ------------------------------------------------------------------------------
# ⚠️  NETLIFY IMPORTANT:
#   Netlify functions have an EPHEMERAL filesystem — local file storage will
#   lose uploaded files on every function restart/deploy.
#
#   For a demo/PFE presentation: set STORAGE_PROVIDER=local and files will
#   survive within the same warm function instance (sufficient for live demos).
#
#   For a persistent production deployment, switch to S3-compatible storage:
#     • Cloudflare R2  (free egress, S3-compatible)
#     • AWS S3
#     • Supabase Storage (S3-compatible endpoint)
#   Then set STORAGE_PROVIDER=s3 and fill in the S3 variables below.
#
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH="./storage/private"

# S3 / Cloudflare R2 / Supabase Storage (if STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Admin Seed Account  (used by scripts/seed.mjs)
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL="admin@stagelink.ma"
ADMIN_INITIAL_PASSWORD="ChangeMeInProd123!"

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_AI_RPM=10
RATE_LIMIT_API_RPM=60
